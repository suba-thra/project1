# Database Environment Variables Template
# Copy this file or set these variables in your environment/IDE before running the application.

# MySQL Database URL
DB_URL=jdbc:mysql://localhost:3306/quiz_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL Database Username
DB_USERNAME=root

# MySQL Database Password (keep secret, DO NOT commit your real password to Git)
DB_PASSWORD=your_mysql_password_here

# Instructions for Windows PowerShell:
# $env:DB_USERNAME="root"
# $env:DB_PASSWORD="your_mysql_password_here"
# .\mvnw.cmd spring-boot:run
